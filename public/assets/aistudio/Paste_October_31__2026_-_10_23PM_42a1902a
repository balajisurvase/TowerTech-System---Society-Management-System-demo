## 2. Add automatic maintenance payment calculation

Run this additional SQL after the main migration. It ensures that successful payments allocated to maintenance bills automatically update the bill's paid and outstanding amounts.

```

-- Automatically recalculate maintenance bill balances

CREATE OR REPLACE FUNCTION public.towertech_recalculate_bill()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    target_bill UUID;
BEGIN
    IF TG_OP = 'DELETE' THEN
        target_bill := OLD.bill_id;
    ELSE
        target_bill := NEW.bill_id;
    END IF;

    UPDATE public.maintenance_bills b
    SET
        paid_amount = COALESCE((
            SELECT SUM(pa.allocated_amount)
            FROM public.payment_allocations pa
            JOIN public.financial_payments p
              ON p.id = pa.payment_id
            WHERE pa.bill_id = target_bill
              AND p.status = 'successful'
        ), 0),

        outstanding_amount = GREATEST(
            b.total_amount - COALESCE((
                SELECT SUM(pa.allocated_amount)
                FROM public.payment_allocations pa
                JOIN public.financial_payments p
                  ON p.id = pa.payment_id
                WHERE pa.bill_id = target_bill
                  AND p.status = 'successful'
            ), 0),
            0
        ),

        status = CASE
            WHEN b.status = 'cancelled' THEN 'cancelled'
            WHEN COALESCE((
                SELECT SUM(pa.allocated_amount)
                FROM public.payment_allocations pa
                JOIN public.financial_payments p
                  ON p.id = pa.payment_id
                WHERE pa.bill_id = target_bill
                  AND p.status = 'successful'
            ), 0) >= b.total_amount THEN 'paid'
            WHEN COALESCE((
                SELECT SUM(pa.allocated_amount)
                FROM public.payment_allocations pa
                JOIN public.financial_payments p
                  ON p.id = pa.payment_id
                WHERE pa.bill_id = target_bill
                  AND p.status = 'successful'
            ), 0) > 0 THEN 'partially_paid'
            WHEN b.due_date < CURRENT_DATE THEN 'overdue'
            ELSE 'unpaid'
        END

    WHERE b.id = target_bill;

    RETURN NULL;
END;
$$;

DROP TRIGGER IF EXISTS recalculate_bill_after_allocation
ON public.payment_allocations;

CREATE TRIGGER recalculate_bill_after_allocation
AFTER INSERT OR UPDATE OR DELETE
ON public.payment_allocations
FOR EACH ROW
EXECUTE FUNCTION public.towertech_recalculate_bill();

CREATE OR REPLACE FUNCTION public.towertech_payment_status_changed()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    r RECORD;
BEGIN
    IF NEW.status IS DISTINCT FROM OLD.status THEN
        FOR r IN
            SELECT DISTINCT bill_id
            FROM public.payment_allocations
            WHERE payment_id = NEW.id
        LOOP
            UPDATE public.maintenance_bills b
            SET
                paid_amount = COALESCE((
                    SELECT SUM(pa.allocated_amount)
                    FROM public.payment_allocations pa
                    JOIN public.financial_payments p
                      ON p.id = pa.payment_id
                    WHERE pa.bill_id = r.bill_id
                      AND p.status = 'successful'
                ), 0),

                outstanding_amount = GREATEST(
                    b.total_amount - COALESCE((
                        SELECT SUM(pa.allocated_amount)
                        FROM public.payment_allocations pa
                        JOIN public.financial_payments p
                          ON p.id = pa.payment_id
                        WHERE pa.bill_id = r.bill_id
                          AND p.status = 'successful'
                    ), 0),
                    0
                ),

                status = CASE
                    WHEN b.status = 'cancelled' THEN 'cancelled'
                    WHEN COALESCE((
                        SELECT SUM(pa.allocated_amount)
                        FROM public.payment_allocations pa
                        JOIN public.financial_payments p
                          ON p.id = pa.payment_id
                        WHERE pa.bill_id = r.bill_id
                          AND p.status = 'successful'
                    ), 0) >= b.total_amount THEN 'paid'
                    WHEN COALESCE((
                        SELECT SUM(pa.allocated_amount)
                        FROM public.payment_allocations pa
                        JOIN public.financial_payments p
                          ON p.id = pa.payment_id
                        WHERE pa.bill_id = r.bill_id
                          AND p.status = 'successful'
                    ), 0) > 0 THEN 'partially_paid'
                    WHEN b.due_date < CURRENT_DATE THEN 'overdue'
                    ELSE 'unpaid'
                END
            WHERE b.id = r.bill_id;
        END LOOP;
    END IF;

    RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS recalculate_bill_after_payment_status
ON public.financial_payments;

CREATE TRIGGER recalculate_bill_after_payment_status
AFTER UPDATE OF status
ON public.financial_payments
FOR EACH ROW
EXECUTE FUNCTION public.towertech_payment_status_changed();

