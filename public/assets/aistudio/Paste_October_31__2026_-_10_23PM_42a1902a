-- ============================================================
-- 22. UPDATED_AT TRIGGER FUNCTION
-- ============================================================

CREATE OR REPLACE FUNCTION public.towertech_set_updated_at()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$;

DO $$
DECLARE
    tbl TEXT;
BEGIN
    FOREACH tbl IN ARRAY ARRAY[
        'financial_settings',
        'maintenance_bills',
        'financial_payments',
        'expenses'
    ]
    LOOP
        EXECUTE format(
            'DROP TRIGGER IF EXISTS set_updated_at ON public.%I',
            tbl
        );

        EXECUTE format(
            'CREATE TRIGGER set_updated_at
             BEFORE UPDATE ON public.%I
             FOR EACH ROW
             EXECUTE FUNCTION public.towertech_set_updated_at()',
            tbl
        );
    END LOOP;
END;
$$;

-- ============================================================
-- 23. FINANCIAL DASHBOARD VIEW
-- Uses recorded payments and expenses.
-- ============================================================

CREATE OR REPLACE VIEW public.towertech_financial_summary
WITH (security_invoker = true)
AS
SELECT
    s.society_id,

    COALESCE(b.total_billed,0) AS maintenance_generated,
    COALESCE(b.total_outstanding,0) AS maintenance_pending,

    COALESCE(p.total_collected,0) AS total_collected,

    COALESCE(i.total_income,0) AS other_income,

    COALESCE(e.total_expenses,0) AS total_expenses

FROM
    (SELECT DISTINCT society_id
     FROM public.financial_settings) s

LEFT JOIN (
    SELECT society_id,
           SUM(total_amount) AS total_billed,
           SUM(outstanding_amount) AS total_outstanding
    FROM public.maintenance_bills
    WHERE status <> 'cancelled'
    GROUP BY society_id
) b ON b.society_id = s.society_id

LEFT JOIN (
    SELECT society_id,
           SUM(amount) AS total_collected
    FROM public.financial_payments
    WHERE status = 'successful'
    GROUP BY society_id
) p ON p.society_id = s.society_id

LEFT JOIN (
    SELECT society_id,
           SUM(amount) AS total_income
    FROM public.income_entries
    GROUP BY society_id
) i ON i.society_id = s.society_id

LEFT JOIN (
    SELECT society_id,
           SUM(paid_amount) AS total_expenses
    FROM public.expenses
    WHERE approval_status = 'approved'
    GROUP BY society_id
) e ON e.society_id = s.society_id;

-- ============================================================
-- 24. SOCIETY-LEVEL ACCESS HELPER
-- Reads the existing users table without recreating it.
-- Supports either id or user_id as the user identifier.
-- ============================================================

CREATE OR REPLACE FUNCTION public.towertech_current_society_id()
RETURNS TEXT
LANGUAGE plpgsql
STABLE
SECURITY DEFINER
SET search_path = ''
AS $$
DECLARE
    result TEXT;
BEGIN
    IF auth.uid() IS NULL THEN
        RETURN NULL;
    END IF;

    EXECUTE
        'SELECT to_jsonb(u)->>''society_id''
         FROM public.users u
         WHERE COALESCE(
             to_jsonb(u)->>''id'',
             to_jsonb(u)->>''user_id''
         ) = $1
         LIMIT 1'
    INTO result
    USING auth.uid()::TEXT;

    RETURN result;
EXCEPTION
    WHEN undefined_table THEN
        RETURN NULL;
END;
$$;

-- ============================================================
-- 25. ENABLE ROW LEVEL SECURITY
-- ============================================================

DO $$
DECLARE
    tbl TEXT;
BEGIN
    FOREACH tbl IN ARRAY ARRAY[
        'financial_settings',
        'maintenance_rates',
        'maintenance_bills',
        'maintenance_bill_items',
        'financial_payments',
        'payment_allocations',
        'payment_receipts',
        'income_entries',
        'expense_categories',
        'expenses',
        'expense_approvals',
        'staff_members',
        'staff_salary_payments',
        'financial_vendors',
        'vendor_invoices',
        'society_funds',
        'fund_transactions',
        'financial_accounts',
        'journal_entries',
        'journal_lines',
        'bank_reconciliations',
        'financial_audit_logs'
    ]
    LOOP
        EXECUTE format(
            'ALTER TABLE public.%I ENABLE ROW LEVEL SECURITY',
            tbl
        );

        EXECUTE format(
            'DROP POLICY IF EXISTS society_financial_access ON public.%I',
            tbl
        );

        EXECUTE format(
            'CREATE POLICY society_financial_access
             ON public.%I
             FOR ALL
             TO authenticated
             USING (
                 society_id = (
                     SELECT public.towertech_current_society_id()
                 )
             )
             WITH CHECK (
                 society_id = (
                     SELECT public.towertech_current_society_id()
                 )
             )',
            tbl
        );
    END LOOP;
END;
$$;

