Here is the complete TowerTech Financial Management Database SQL for Supabase (PostgreSQL).

This database covers maintenance billing, payments, receipts, income, expenses, staff salaries, vendors, society funds, bank accounts, financial reports, and audit logs.



Supabase PostgreSQL

Financial Module

Additive migration



Important database instructions:

- Existing TowerTech tables must not be deleted or modified.
- Do not recreate existing `users`, `societies`, or `flats` tables.
- Use the existing society and flat IDs.
- Financial records must be isolated by `society_id`.
- Use Indian Rupees (INR).
- Maintain transaction history and audit records.
- The SQL below creates additional financial tables only.

I have kept the society and flat references compatible with the existing TowerTech visitor-module approach, where `society_id` and `flat_id` are stored as text identifiers.&#x20;

## 1. Complete SQL migration

Open Supabase → SQL Editor → New Query, then paste and execute the following SQL.

```

-- ============================================================
-- TOWERTECH FINANCIAL MANAGEMENT MODULE
-- PostgreSQL / Supabase
-- Additive database migration
-- Currency: INR
-- ============================================================

CREATE EXTENSION IF NOT EXISTS pgcrypto;

-- ============================================================
-- 1. FINANCIAL SETTINGS
-- ============================================================

CREATE TABLE IF NOT EXISTS public.financial_settings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    society_id TEXT NOT NULL UNIQUE,
    currency TEXT NOT NULL DEFAULT 'INR',
    financial_year_start DATE,
    billing_day INTEGER DEFAULT 1 CHECK (billing_day BETWEEN 1 AND 28),
    due_day INTEGER DEFAULT 10 CHECK (due_day BETWEEN 1 AND 28),
    grace_period_days INTEGER DEFAULT 5,
    late_fee_type TEXT DEFAULT 'fixed'
        CHECK (late_fee_type IN ('fixed','percentage')),
    late_fee_amount NUMERIC(14,2) DEFAULT 0,
    billing_frequency TEXT DEFAULT 'monthly'
        CHECK (billing_frequency IN ('monthly','quarterly','yearly')),
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- ============================================================
-- 2. MAINTENANCE RATE CONFIGURATION
-- ============================================================

CREATE TABLE IF NOT EXISTS public.maintenance_rates (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    society_id TEXT NOT NULL,
    rate_name TEXT NOT NULL,
    calculation_method TEXT NOT NULL
        CHECK (calculation_method IN
        ('per_bhk','per_sqft','hybrid','fixed')),

    bhk_type TEXT,
    rate_per_sqft NUMERIC(14,2) DEFAULT 0,
    base_amount NUMERIC(14,2) DEFAULT 0,
    fixed_amount NUMERIC(14,2) DEFAULT 0,

    effective_from DATE NOT NULL,
    effective_to DATE,

    is_active BOOLEAN DEFAULT TRUE,
    created_by UUID REFERENCES auth.users(id),
    created_at TIMESTAMPTZ DEFAULT NOW(),

    CHECK (effective_to IS NULL OR effective_to >= effective_from)
);

CREATE INDEX IF NOT EXISTS idx_maintenance_rates_society
ON public.maintenance_rates(society_id);

-- ============================================================
-- 3. MAINTENANCE BILLS
-- ============================================================

CREATE TABLE IF NOT EXISTS public.maintenance_bills (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    society_id TEXT NOT NULL,
    flat_id TEXT NOT NULL,
    flat_number TEXT NOT NULL,

    resident_name TEXT,
    resident_user_id UUID REFERENCES auth.users(id),

    bill_number TEXT NOT NULL,
    billing_month DATE NOT NULL,

    calculation_method TEXT,
    bhk_type TEXT,
    flat_area NUMERIC(12,2) DEFAULT 0,
    rate_per_unit NUMERIC(14,2) DEFAULT 0,

    maintenance_amount NUMERIC(14,2) DEFAULT 0,
    additional_charges NUMERIC(14,2) DEFAULT 0,
    previous_balance NUMERIC(14,2) DEFAULT 0,
    late_fee NUMERIC(14,2) DEFAULT 0,
    discount NUMERIC(14,2) DEFAULT 0,

    total_amount NUMERIC(14,2) NOT NULL DEFAULT 0,
    paid_amount NUMERIC(14,2) NOT NULL DEFAULT 0,
    outstanding_amount NUMERIC(14,2) NOT NULL DEFAULT 0,

    due_date DATE NOT NULL,

    status TEXT NOT NULL DEFAULT 'generated'
        CHECK (status IN
        ('draft','generated','unpaid','partially_paid',
         'paid','overdue','cancelled')),

    notes TEXT,
    generated_by UUID REFERENCES auth.users(id),

    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),

    UNIQUE(society_id, bill_number),
    UNIQUE(society_id, flat_id, billing_month),

    CHECK (total_amount >= 0),
    CHECK (paid_amount >= 0),
    CHECK (outstanding_amount >= 0),
    CHECK (discount >= 0)
);

CREATE INDEX IF NOT EXISTS idx_bills_society
ON public.maintenance_bills(society_id);

CREATE INDEX IF NOT EXISTS idx_bills_flat
ON public.maintenance_bills(flat_id);

CREATE INDEX IF NOT EXISTS idx_bills_status
ON public.maintenance_bills(society_id,status);

CREATE INDEX IF NOT EXISTS idx_bills_due_date
